{
  "name": "protect-context",
  "version": "1.3.0",
  "description": "Pi extension that adds agent guardrails: context brief, verification evidence, loop blocking, diff-scope warnings, and a durable journal.",
  "type": "module",
  "license": "MIT",
  "keywords": [
    "pi-package",
    "pi-extension",
    "pi",
    "guardrails",
    "agent-safety",
    "context"
  ],
  "homepage": "https://github.com/XJTLUmedia/Protect-Context-Pi-Coding-Agent",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/XJTLUmedia/Protect-Context-Pi-Coding-Agent.git"
  },
  "bugs": {
    "url": "https://github.com/XJTLUmedia/Protect-Context-Pi-Coding-Agent/issues"
  },
  "pi": {
    "extensions": [
      "./extension/index.ts"
    ],
    "image": "./preview.png"
  },
  "files": [
    "extension/index.ts",
    "extension/lib",
    "preview.png",
    "LICENSE"
  ],
  "engines": {
    "node": ">=22.19.0"
  },
  "scripts": {
    "pretest": "node --input-type=module -e \"import{existsSync,readdirSync}from'node:fs';const d='extension/test';const ok=existsSync(d)&&readdirSync(d).some(f=>f.endsWith('.test.ts'));if(!ok){console.error('pretest: no extension/test/*.test.ts found here. Tests ship only in the repository checkout, not in the npm tarball.');process.exit(1)}\"",
    "test": "node --experimental-strip-types --test extension/test/*.test.ts",
    "typecheck": "tsc --noEmit -p extension/tsconfig.json",
    "check": "npm run typecheck && npm test",
    "prepublishOnly": "npm run check"
  },
  "peerDependencies": {
    "@earendil-works/pi-ai": "*",
    "@earendil-works/pi-coding-agent": "*",
    "typebox": "*"
  },
  "devDependencies": {
    "@earendil-works/pi-ai": "0.84.4",
    "@earendil-works/pi-coding-agent": "0.84.4",
    "@types/node": "22.20.1",
    "typebox": "1.3.23",
    "typescript": "7.0.2"
  }
}
